{
  "name": "node-rest-ts-jest-strykerjs",
  "version": "1.0.0",
  "description": "A simple example to use StrykerJS in Node Rest API using Typescript and Jest",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest --detectOpenHandles --runInBand",
    "coverage": "npm test -- --coverage --no-cache --detectOpenHandles",
    "lint": "npx eslint '*/**/*.{js,ts}'",
    "stryker:init": "npx stryker init",
    "stryker:run": "npx stryker run",
    "stryker:defmutator": "npx stryker run --configFile stryker-defmutator.conf.js",
    "defmutator": "ts-node src/cli/defmutator.ts",
    "defmutator:help": "npm run defmutator -- --help",
    "defmutator:services": "npm run defmutator -- ./src/server/services",
    "defmutator:all": "npm run defmutator -- ./src",
    "defmutator:full": "npm run defmutator:all && npm run stryker:defmutator",
    "test:defense": "jest --testNamePattern=\"Defense System\" --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chelosky/Node-Typescript-Jest-StrykerJS"
  },
  "keywords": [
    "Node",
    "Typescript",
    "Jest",
    "StrykerJS"
  ],
  "author": "chelosky",
  "license": "ISC",
  "devDependencies": {
    "@stryker-mutator/api": "^5.6.1",
    "@stryker-mutator/core": "^5.6.1",
    "@stryker-mutator/html-reporter": "^3.1.0",
    "@stryker-mutator/jest-runner": "^5.6.1",
    "@stryker-mutator/typescript": "^4.0.0",
    "@types/jest": "^27.4.1",
    "@types/koa": "^2.13.4",
    "@types/koa__cors": "^3.3.0",
    "@types/koa-bodyparser": "^4.3.7",
    "@types/koa-logger": "^3.1.2",
    "@types/koa-router": "^7.4.4",
    "@types/node": "^17.0.25",
    "@typescript-eslint/eslint-plugin": "^5.20.0",
    "@typescript-eslint/parser": "^5.20.0",
    "eslint": "^8.14.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.1.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "jest": "^27.5.1",
    "nodemon": "^2.0.15",
    "stryker": "^0.35.1",
    "stryker-cli": "^1.0.2",
    "stryker-jest-runner": "^1.4.1",
    "stryker-typescript": "^0.18.1",
    "ts-jest": "^27.1.4",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@koa/cors": "^3.3.0",
    "@types/glob": "^8.1.0",
    "axios": "^1.11.0",
    "dotenv": "^16.0.0",
    "glob": "^11.0.3",
    "joi": "^17.6.0",
    "koa": "^2.13.4",
    "koa-bodyparser": "^4.3.0",
    "koa-logger": "^3.2.1",
    "koa-router": "^10.1.1"
  }
}
